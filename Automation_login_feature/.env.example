# API Configuration
API_BASE_URL=https://cmma-dev.cosdevx.com
TENANT_BASE_URL_TEMPLATE=https://{tenant_slug}-cmma-dev.cosdevx.com
API_TIMEOUT=10

# Test Credentials (Override with CI / Sandbox secrets)
TEST_PLATFORM_ADMIN_EMAIL=admin@cmma.io
TEST_PLATFORM_ADMIN_PASSWORD=SecureAdminPassword123!
TEST_TENANT_SLUG=danis
TEST_TENANT_USER_EMAIL=user@danis.com
TEST_TENANT_USER_PASSWORD=SecurePassword123!
TEST_DEACTIVATED_USER_EMAIL=deactivated@danis.com
TEST_SSO_USER_EMAIL=sso.user@danis.com
TEST_DEVICE_FP_TRUSTED=trusted-tenant-fp-999
TEST_DEVICE_FP_EXPIRED=expired-device-fp-100
TEST_DEVICE_FP_UNTRUSTED=untrusted-device-fp-200

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmma_db
DB_USER=cmma_app
DB_PASSWORD=cmma_password
DB_SSLMODE=prefer
